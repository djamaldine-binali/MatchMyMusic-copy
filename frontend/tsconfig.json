{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["cypress"],
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "src",
    "cypress",
    "cypress.config.ts"
  ]
}


